{
	"compilerOptions": {
		"skipLibCheck": true,
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2018",
		"allowJs": true,
		"strict": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"importHelpers": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"lib": ["DOM", "DOM.Iterable", "ES2018", "ES2021.String"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
