{
	"name": "obsidian-linear-calendar",
	"version": "0.2.0",
	"description": "A horizontal year-at-a-glance timeline view for Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "bun esbuild.config.mjs production",
		"deploy": "bun run check && bun esbuild.config.mjs production && bun run scripts/deploy.mjs",
		"check": "bun run typecheck && bun run lint && bun run test",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "eslint 'src/**/*.ts' --ignore-pattern 'src/**/*.test.ts' --max-warnings=0",
		"lint:fix": "eslint 'src/**/*.ts' --ignore-pattern 'src/**/*.test.ts' --max-warnings=0 --fix",
		"sync:lucide": "node scripts/sync-lucide-icons.mjs"
	},
	"devDependencies": {
		"@types/node": "^26.1.0",
		"@typescript-eslint/parser": "^8.62.1",
		"@vitest/coverage-v8": "4.1.11",
		"builtin-modules": "^5.3.0",
		"esbuild": "^0.28.1",
		"eslint": "^10.6.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"lucide-static": "1.33.0",
		"moment": "2.29.4",
		"obsidian": "1.13.1",
		"typescript": "6.0.3",
		"vitest": "4.1.11"
	}
}
