{
	"name": "obsidian-linear-calendar",
	"version": "0.1.0",
	"description": "A horizontal year-at-a-glance timeline view for Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "bun esbuild.config.mjs production",
		"deploy": "bun run typecheck && bun esbuild.config.mjs production && bun run scripts/deploy.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "eslint 'src/**/*.ts' --ignore-pattern 'src/**/*.test.ts'",
		"lint:fix": "eslint 'src/**/*.ts' --ignore-pattern 'src/**/*.test.ts' --fix"
	},
	"devDependencies": {
		"@types/node": "^26.1.0",
		"@typescript-eslint/parser": "^8.62.1",
		"builtin-modules": "^5.3.0",
		"esbuild": "^0.28.1",
		"eslint": "^10.6.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "latest",
		"typescript": "6.0.3",
		"vitest": "^4.1.9"
	}
}
